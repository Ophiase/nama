{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "read": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" },
    "edit": { "*": "allow", "*.env": "ask", "*.env.*": "ask", "*.env.example": "allow" },
    "bash": {
      "*": "ask",
      "just *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "rumdl *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "jq *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "git push *": "ask",
      "git clean *": "ask",
      "git rebase *": "ask",
      "git clone *": "ask",
      "gh *": "ask",
      "curl *": "ask",
      "wget *": "ask",
      "docker push *": "ask",
      "sudo *": "deny",
      "env": "deny",
      "printenv*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git filter-branch*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny"
    },
    "external_directory": { "*": "ask" },
    "doom_loop": { "*": "ask" },
    "webfetch": { "*": "ask" },
    "websearch": { "*": "ask" },
    "task": { "*": "allow" },
    "skill": { "*": "allow" },
    "lsp": { "*": "allow" },
    "todoread": { "*": "allow" },
    "todowrite": { "*": "allow" }
  }
}
